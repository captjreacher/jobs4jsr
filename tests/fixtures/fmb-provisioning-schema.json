    "constraints": [
      {
        "relname": "profiles",
        "definition": "CHECK (((is_seeded = false) OR (user_id = '00000000-0000-0000-0000-000000000001'::uuid)))"
      },
      {
        "relname": "profiles",
        "definition": "PRIMARY KEY (id)"
      },
      {
        "relname": "profiles",
        "definition": "FOREIGN KEY (suspended_by) REFERENCES auth.users(id)"
      },
      {
        "relname": "subscriptions",
        "definition": "PRIMARY KEY (id)"
      },
      {
        "relname": "subscriptions",
        "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
      },
      {
        "relname": "user_entitlements",
        "definition": "CHECK ((deployment_limit >= 0))"
      },
      {
        "relname": "user_entitlements",
        "definition": "PRIMARY KEY (user_id)"
      },
      {
        "relname": "user_entitlements",
        "definition": "CHECK ((plan = ANY (ARRAY['free'::text, 'creator'::text, 'pro'::text])))"
      },
      {
        "relname": "user_entitlements",
        "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"

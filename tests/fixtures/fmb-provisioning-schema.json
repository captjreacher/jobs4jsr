{
  "triggers": [
    {
      "nspname": "auth",
      "relname": "users",
      "tgname": "on_auth_user_created",
      "definition": "CREATE TRIGGER on_auth_user_created AFTER INSERT ON auth.users FOR EACH ROW EXECUTE FUNCTION handle_new_user()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nBEGIN\r\n  INSERT INTO public.profiles (id, email, full_name)\r\n  VALUES (NEW.id, NEW.email, NEW.raw_user_meta_data->>'full_name');\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
    },
    {
      "nspname": "auth",
      "relname": "users",
      "tgname": "on_auth_user_created_subscription",
      "definition": "CREATE TRIGGER on_auth_user_created_subscription AFTER INSERT ON auth.users FOR EACH ROW EXECUTE FUNCTION handle_new_user_subscription()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.handle_new_user_subscription()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nBEGIN\r\n  INSERT INTO public.subscriptions (user_id, status, plan)\r\n  VALUES (NEW.id, 'active', 'free');\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
    },
    {
      "nspname": "auth",
      "relname": "users",
      "tgname": "trg_auth_users_seed_entitlement",
      "definition": "CREATE TRIGGER trg_auth_users_seed_entitlement AFTER INSERT ON auth.users FOR EACH ROW EXECUTE FUNCTION seed_user_entitlement()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.seed_user_entitlement()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  insert into public.user_entitlements (user_id, plan, deployment_limit)\n  values (new.id, 'free', 1)\n  on conflict (user_id) do nothing;\n  return new;\nend;\n$function$\n"
    },
    {
      "nspname": "public",
      "relname": "profiles",
      "tgname": "trg_profiles_bump_version",
      "definition": "CREATE TRIGGER trg_profiles_bump_version BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE FUNCTION bump_version()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.bump_version()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nbegin\n  new.version = old.version + 1;\n  return new;\nend;\n$function$\n"
    },
    {
      "nspname": "public",
      "relname": "profiles",
      "tgname": "trg_profiles_enforce_limit",
      "definition": "CREATE TRIGGER trg_profiles_enforce_limit BEFORE INSERT ON public.profiles FOR EACH ROW EXECUTE FUNCTION enforce_profile_limit()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.enforce_profile_limit()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\ndeclare\n  active_count integer;\nbegin\n  if new.is_active is distinct from true then\n    return new;\n  end if;\n\n  select count(*) into active_count\n  from public.profiles p\n  where p.user_id = new.user_id\n    and p.is_active = true;\n\n  if active_count >= 10 then\n    raise exception 'PROFILE_LIMIT_REACHED'\n      using errcode = 'P0001',\n            detail = 'A user can only have up to 10 active profiles.';\n  end if;\n\n  return new;\nend;\n$function$\n"
    },
    {
      "nspname": "public",
      "relname": "profiles",
      "tgname": "trg_profiles_set_updated_at",
      "definition": "CREATE TRIGGER trg_profiles_set_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE FUNCTION set_updated_at()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n"
    },
    {
      "nspname": "public",
      "relname": "user_entitlements",
      "tgname": "trg_user_entitlements_set_updated_at",
      "definition": "CREATE TRIGGER trg_user_entitlements_set_updated_at BEFORE UPDATE ON public.user_entitlements FOR EACH ROW EXECUTE FUNCTION set_updated_at()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n"
    }
  ],

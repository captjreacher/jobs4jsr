# Discovery and letters need no paid APIs. Sync is optional; no service-role key.
JOBS4JSR_SUPABASE_URL=https://qnvihygrnfgpmsznayje.supabase.co
JOBS4JSR_PUBLISHABLE_KEY=
JOBS4JSR_SYNC_EMAIL=
JOBS4JSR_SYNC_PASSWORD=
JOBS4JSR_OWNER_ID=
# Leave false until separate privacy approval for cloud letter upload.
JOBS4JSR_LETTER_UPLOAD_APPROVED=false
# Disabled until separate poller installation / live discovery authorisation.
JOBS4JSR_MANUAL_UPDATES_ENABLED=false
# Weekday evening digest (Mon-Fri 18:00 Pacific/Auckland). Use an app password, never the
# account password. Leave blank to keep the digest disabled; no email is sent when a run
# produces no new roles. SMTP_SECURITY must be exactly 'starttls' or 'ssl': any other value
# is refused rather than downgraded, and the server certificate is verified before login.
JOBS4JSR_SMTP_HOST=
JOBS4JSR_SMTP_PORT=587
JOBS4JSR_SMTP_SECURITY=starttls
JOBS4JSR_SMTP_USER=
JOBS4JSR_SMTP_PASSWORD=
JOBS4JSR_DIGEST_FROM=
JOBS4JSR_DIGEST_TO=
